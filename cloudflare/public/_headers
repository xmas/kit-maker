# Cloudflare Pages headers (the same policy as internal/http/headers.go,
# plus 'wasm-unsafe-eval' so the page can run the engine).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/kitmaker.wasm
  Cache-Control: public, max-age=0, must-revalidate

/starter.json
  Cache-Control: public, max-age=0, must-revalidate
