# Kit Maker settings for the local stack (deploy/compose).
#
# `make up` copies this file to deploy/compose/kitmaker.env on first run.
# kitmaker.env is git-ignored, so put local secrets there, never here.
# After editing kitmaker.env, run `make restart` to apply it.
#
# Admin commands run inside the stack with `make cli`, e.g.
#   make cli ARGS="--help"
#   make cli ARGS="seed --admin-email you@example.com"
#
# Database, storage, registry, BuildKit and SMTP wiring live in compose.yaml,
# because they point at the stack's own containers.

# --- Generated ----------------------------------------------------------------
# `make env` appends KITMAKER_SECRETS_URL (the local key that seals stored
# integration secrets) and KITMAKER_BOOTSTRAP_PASSWORD to kitmaker.env.

# --- Bootstrap ----------------------------------------------------------------
# The first Owner account (break-glass). Change it before running `make up`
# the first time, or re-run `make cli ARGS="seed --admin-email …"`.
KITMAKER_BOOTSTRAP_ADMIN=admin@kitmaker.local

# --- Logging ------------------------------------------------------------------
# json | text
KITMAKER_LOG_FORMAT=json
# debug | info | warn | error
KITMAKER_LOG_LEVEL=info

# --- AI (phase 1+) ---------------------------------------------------------------
# fake replays recorded fixtures and needs no key. anthropic uses the key below.
# KITMAKER_AI_DRIVER=fake
# ANTHROPIC_API_KEY=

# --- Sign-in providers (phase 1+) ----------------------------------------------------
# Each provider can also be configured in the admin UI. Values here seed it.
# KITMAKER_AUTH_LOCAL=true
# KITMAKER_AUTH_ENTRA_TENANT_ID=
# KITMAKER_AUTH_ENTRA_CLIENT_ID=
# KITMAKER_AUTH_ENTRA_CLIENT_SECRET=
# KITMAKER_AUTH_OKTA_ISSUER=
# KITMAKER_AUTH_OKTA_CLIENT_ID=
# KITMAKER_AUTH_OKTA_CLIENT_SECRET=
# KITMAKER_AUTH_GOOGLE_CLIENT_ID=
# KITMAKER_AUTH_GOOGLE_CLIENT_SECRET=
# KITMAKER_AUTH_GOOGLE_HOSTED_DOMAIN=
