{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "vite/client",
      "node"
    ],
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "app.ts",
    "inertia.ts",
    "lite/**/*",
    "env.d.ts",
    "vite.config.ts",
    "vite.cloudflare.config.ts",
    "pages/**/*",
    "components/**/*"
  ]
}
